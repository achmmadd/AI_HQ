# Copy to infra/postgres/.env on Hetzner (chmod 600). Never commit .env.

# Database credentials (used by docker-compose and DATABASE_URL on NUC)
POSTGRES_USER=motor
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-32
POSTGRES_DB=motor_ai

# Bind address: 127.0.0.1 for local-only, or Tailscale IP for NUC access
# Example Tailscale: 100.x.x.x
POSTGRES_BIND=127.0.0.1

# NUC Motor app (.env.local) — same credentials, Tailscale hostname:
# DATABASE_URL=postgres://motor:PASSWORD@hetzner-motor:5432/motor_ai
