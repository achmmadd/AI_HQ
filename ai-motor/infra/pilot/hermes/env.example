# Voorbeeldconfiguratie voor de hermes-sidecar — ALLEEN fictieve waarden.
# De repo is publiek: nooit echte tailnet-IP's, hostnames, usernames of
# secrets committen. Gebruik: voeg deze waarden toe aan de bestaande
# (gitignored) .env naast infra/pilot/compose.yaml op Hetzner.

# OpenAI-compatible endpoint van de lokale modelruntime (Motor ModelPort).
# Enige egress-bestemming van de sidecar. In tests/CI is dit ALTIJD een
# fake endpoint, nooit de echte RTX. De sidecar bevat zelf geen API-key.
MODEL_PORT_URL=http://<RTX_TAILNET_IP>:8080/v1
MODEL_NAME=Qwen3.6-35B-A3B-UD-Q4_K_XL

# Container-poort van het sidecarprotocol (alleen intern netwerk, nooit
# publiem gepubliceerd).
HERMES_SIDECAR_PORT=4410

# Begrensde model-wachttijd per attempt in seconden; protocolplafond 120.
# Kies in een deployment iets onder de invoke-timeout van de Node-adapter,
# zodat de sidecar zijn eigen gecontroleerde fout vóór de client-timeout
# teruggeeft.
MODEL_REQUEST_TIMEOUT_S=120
