# Voorbeeldconfiguratie voor de agentscope-sidecar — ALLEEN fictieve waarden.
# De repo bevat nooit echte tailnet-IP's, hostnames, usernames of secrets.
# Gebruik: voeg deze waarden toe aan de bestaande (gitignored) .env naast
# infra/pilot/compose.yaml op Hetzner.

# OpenAI-compatible endpoint van de lokale modelruntime (Motor ModelPort).
# Enige egress-bestemming van de sidecar. llama.cpp vraagt geen API-key en
# de sidecar bevat er dan ook geen (placeholder in sidecar.py, geen secret).
MODEL_PORT_URL=http://<RTX_TAILNET_IP>:8080/v1
MODEL_NAME=Qwen3.6-35B-A3B-UD-Q4_K_XL
