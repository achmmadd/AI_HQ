# motor-pilot .env — VOORBEELD MET FICTIEVE WAARDEN.
# Kopieer naar .env (gitignored) naast compose.yaml op Hetzner en vul de
# echte runtime-waarden in. De echte .env wordt nooit gecommit.

# Tailnet-URL van de llama-server op de inference-PC (ModelPort-endpoint).
MODEL_PORT_URL=http://100.x.y.z:8080

# Tailnet-IP van deze Hetzner-host waar de API op bindt (nooit 0.0.0.0).
PILOT_API_HOST=100.a.b.c

# Fail-closed ACL: stabiele Tailscale node-ID's → toegestane workspaces.
# De stabiele ID (n…CNTRL) vind je via: tailscale whois <ip> (veld "ID"),
# en overleeft — anders dan de node-naam — hernoemingen. Leeg = niemand.
PILOT_ACL={"n1EXAMPLE23CNTRL":["ws-motor"],"n4EXAMPLE56CNTRL":["ws-motor"]}

# Optioneel: afwijkende modelnaam (moet matchen met de geladen GGUF).
# MODEL_NAME=Qwen3.6-35B-A3B-UD-Q4_K_XL

# Optioneel: pad naar de repo-checkout op de host (default ./repo).
# REPO_PATH=/opt/motor-pilot/repo
