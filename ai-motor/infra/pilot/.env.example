# Voorbeeldconfiguratie voor de motor-pilot — ALLEEN fictieve waarden.
# Kopieer naar .env (gitignored) op Hetzner en vul daar de echte waarden.
# De repo bevat nooit echte tailnet-IP's, node-ID's of secrets.

# OpenAI-compatible endpoint van de lokale modelruntime (ModelPort).
MODEL_PORT_URL=http://<RTX_TAILNET_IP>:8080/v1
MODEL_NAME=Qwen3.6-35B-A3B-UD-Q4_K_XL

# Tailnet-IP van de Hetzner-host waarop de API luistert (alleen tailnet).
PILOT_API_HOST=<HETZNER_TAILNET_IP>

# Fail-closed ACL: stabiele Tailscale node-ID's → toegestane workspaces.
# Node-ID's vind je met: tailscale whois --json <ip> | jq .Node.StableID
PILOT_ACL={"nVoorbeeldLaptopIDCntrl":["ws-motor"],"nVoorbeeldTelefoonIDCntrl":["ws-motor"]}

# Contextbron: demo = fictieve "De Linde"-data; private = contextvolume.
CONTEXT_MODE=demo

# Gedeeld secret voor HMAC-ondertekening van gateway-settlements tussen
# API/CLI en de store-service. Genereer: openssl rand -hex 32
PILOT_STORE_SECRET=voorbeeld-geen-echt-secret

# --- P0.8 compose-integratie: adapterkeuze + sidecar-endpoints --------------
# De defaults reproduceren het huidige gedrag (llamacpp direct op het
# ModelPort); het omzetten van PILOT_ADAPTER is een aparte live-stap met
# eigen goedkeuring — zie pilot/evidence/runtime-activation/P08-INTEGRATIE.md.

# Toegestaan (allowlisted registry): llamacpp | hermes | agentscope.
PILOT_ADAPTER=llamacpp

# hermes publiceert bewust GEEN poort: de API (network_mode: host) bereikt de
# sidecar op zijn container-IP op het interne hermes-net — bepaal die bij de
# activatie met docker inspect (exacte commando's in P08-INTEGRATIE.md).
HERMES_SIDECAR_URL=http://<HERMES_CONTAINER_IP>:4410

# agentscope publiceert uitsluitend op host-loopback:
AGENTSCOPE_SIDECAR_URL=http://127.0.0.1:4410

# Sidecar-overlay keys (compose.hermes.yaml; zie ook hermes/env.example).
HERMES_SIDECAR_PORT=4410
MODEL_REQUEST_TIMEOUT_S=120
