# Motor AI — unified Hetzner stack (infra/hetzner)
# Copy: cp env.example .env && fill secrets
# Bind on Tailscale IP so NUC can reach services (tailscale ip -4)

# --- Core ---
POSTGRES_USER=motor
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=motor_ai
# POSTGRES_BIND=100.x.x.x

# QDRANT_BIND=100.x.x.x
# OLLAMA_BIND=100.x.x.x
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Profile: litellm / full ---
OPENROUTER_API_KEY=
LITELLM_MASTER_KEY=
# LITELLM_BIND=100.x.x.x

# --- Profile: n8n / full ---
# N8N_BIND=100.x.x.x
# N8N_HOST=hetzner-motor
# N8N_PROTOCOL=http
# N8N_WEBHOOK_URL=http://hetzner-motor:5678/

TZ=Europe/Amsterdam
