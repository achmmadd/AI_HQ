# Motor AI Factory OS — environment template
# Copy relevant vars to .env.local on NUC (never commit secrets).

# --- Postgres (Fase 1 — ADR-002) ---
# Hetzner via Tailscale; see docs/fase1-postgres.md
DATABASE_URL=postgres://motor:CHANGE_ME@hetzner-motor:5432/motor_ai
USE_POSTGRES=0
POSTGRES_PRIMARY=0
SQLITE_FALLBACK=1

# --- Auth ---
# MOTORSAI_AUTH_USERS=[{"email":"admin@example.com","password":"...","role":"admin","scope":"all"}]

# --- Qdrant (see docs/model-config.md) ---
# QDRANT_URL=http://127.0.0.1:6333
# QDRANT_COLLECTION_PREFIX=factory_os

# --- LLM / chat ---
# OPENROUTER_API_KEY=
# CHAT_MODEL=deepseek/deepseek-v4-pro
