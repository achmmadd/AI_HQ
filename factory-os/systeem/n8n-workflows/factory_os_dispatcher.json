      {
        "parameters": {
          "jsCode": "const inJson = $input.first().json;\nconst pr = $('Parse routing').first().json;\nlet answer = inJson.answer;\nif (answer == null && inJson.data && typeof inJson.data === 'object' && !Array.isArray(inJson.data) && inJson.data.outputs) {\n  const o = inJson.data.outputs;\n  answer = o.answer || o.text || o.result;\n}\nif (answer == null) answer = inJson.text || inJson.message || '';\n\n// Dify Agent Chat: streaming SSE in body/data string (response_mode streaming)\nconst sseRaw = (typeof inJson.data === 'string' ? inJson.data : null) || (typeof inJson.body === 'string' ? inJson.body : '') || '';\nif (!answer && sseRaw.includes('data:')) {\n  let acc = '';\n  for (const line of sseRaw.split(/\\r?\\n/)) {\n    const s = line.trim();\n    if (!s.startsWith('data:')) continue;\n    const payload = s.slice(5).trim();\n    if (payload === '[DONE]') continue;\n    try {\n      const j = JSON.parse(payload);\n      if (j.event === 'agent_message' && typeof j.answer === 'string') acc += j.answer;\n      else if (j.event === 'message' && typeof j.answer === 'string') acc += j.answer;\n      else if (j.answer && typeof j.answer === 'string') acc += j.answer;\n    } catch (e) {}\n  }\n  answer = acc;\n}\n\nif (typeof answer !== 'string') answer = JSON.stringify(answer || '');\nif (!answer && inJson.error) answer = 'Dify/HTTP-fout: ' + String(inJson.error.message || JSON.stringify(inJson.error)).slice(0, 800);\nif (!answer) answer = 'Geen antwoord van Dify (Agent-app: streaming; Chatbot-app: blocking mogelijk. Check workflow + DIFY_RESEARCH_API_KEY + FACTORY_OS_DIFY_API_BASE).';\n\nconst klant = $('Prepare').first().json.klant || 'algemeen';\nconst afdeling = pr.afdeling || 'research';\nconst complexiteit = pr.complexiteit || 'normaal';\nconst datum = new Date().toLocaleDateString('nl-NL');\nconst ceoNote = pr.ceo_fallback ? ('\\n\\n---\\n_Let op: Optimus CEO overgeslagen (ratelimit/serverfout). Tijdelijk afdeling **research**; Dify voert het werk uit._\\n') : '';\n\nconst lines = answer.split('\\n');\nconst summary = lines.slice(0, 3).join('\\n');\nconst isErr = !String(answer || '').trim() || String(answer).startsWith('Dify/HTTP-fout') || String(answer).includes('Geen antwoord van Dify');\n\nconst output = `# Factory OS Response\\n**Klant:** ${klant} · **Afdeling:** ${afdeling} · **Datum:** ${datum}\\n\\n## Samenvatting\\n${summary}\\n\\n## Volledige response\\n${answer}${ceoNote}\\n\\n---\\n*Factory OS · ${afdeling} · ${complexiteit}*`;\n\nconst model = pr.ceo_fallback ? 'ceo-fallback + dify-agent' : 'openclaw-routing + dify-agent';\nreturn [{ json: {\n  output,\n  answer_raw: answer,\n  afdeling,\n  complexiteit,\n  klant,\n  status: isErr ? 'error' : 'ok',\n  model,\n  ceo_fallback: !!pr.ceo_fallback\n}}];"
        },
