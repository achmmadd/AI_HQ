              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ model: $env.FACTORY_OS_OPTIMUS_MODEL || 'optimus-router', messages: [{ role: 'system', content: 'Je bent de CEO van Factory OS. Analyseer de prompt en retourneer ALLEEN dit JSON object zonder andere tekst:\\n{\"afdeling\": \"fabriek of marketing of research of it of sales of finance\", \"complexiteit\": \"snel of normaal of diep\"}' }, { role: 'user', content: 'Klant: ' + $json.klant + '\\nVraag: ' + $json.prompt }], stream: false }) }}",
          "options": {
            "timeout": 120000
          }
        },
