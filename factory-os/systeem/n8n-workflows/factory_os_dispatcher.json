        "id": "d4-http",
        "name": "Optimus CEO routing",
        "continueOnFail": true,
        "alwaysOutputData": true
      },
      {
        "parameters": {
          "jsCode": "const raw = $input.first().json;\nconst prep = $('Prepare').first().json;\nconst klant = prep.klant || 'algemeen';\nconst prompt = prep.prompt || '';\n\nif (raw.error) {\n  return [{\n    json: {\n      prompt,\n      klant,\n      afdeling: 'research',\n      complexiteit: 'normaal',\n      status: 'ok',\n      ceo_fallback: true,\n      ceo_error_hint: String(raw.error.message || JSON.stringify(raw.error)).slice(0, 400)\n    }\n  }];\n}\n\nconst content = (raw.choices && raw.choices[0] && raw.choices[0].message && raw.choices[0].message.content) || '';\nlet routing = { afdeling: 'research', complexiteit: 'normaal' };\ntry {\n  const m = content.match(/\\{[\\s\\S]*?\\}/);\n  if (m) {\n    const o = JSON.parse(m[0]);\n    if (o.afdeling) routing.afdeling = String(o.afdeling).trim().split(/\\s+/)[0];\n    if (o.complexiteit) routing.complexiteit = String(o.complexiteit).trim().split(/\\s+/)[0];\n  }\n} catch (e) {}\n\nconst afd = (routing.afdeling || 'research').toLowerCase();\nconst cx = (routing.complexiteit || 'normaal').toLowerCase();\nreturn [{\n  json: {\n    prompt,\n    klant,\n    afdeling: afd,\n    complexiteit: cx,\n    status: 'ok'\n  }\n}];"
        },
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
