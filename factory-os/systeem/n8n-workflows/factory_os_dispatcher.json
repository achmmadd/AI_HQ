      {
        "parameters": {
          "jsCode": "const j = $input.first().json;\nconst b = j.body && typeof j.body === 'object' && !Array.isArray(j.body) ? j.body : j;\nconst prompt = String(b.prompt ?? '');\nconst klant = String(b.klant ?? 'algemeen');\nconst key = ($env.OPENAI_API_KEY || $env.OPTIMUS_API_KEY || '').trim();\nif (!key) {\n  return [{\n    json: {\n      output: 'Factory OS: zet OPENAI_API_KEY of OPTIMUS_API_KEY in AI_HQ/.env en docker compose up -d.',\n      status: 'config_error',\n      klant,\n      afdeling: 'n/a',\n      complexiteit: 'n/a'\n    }\n  }];\n}\nreturn [{ json: { prompt, klant, status: '__ok' } }];"
